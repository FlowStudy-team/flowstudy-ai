DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Provider-neutral aliases; use these for Qwen or another OpenAI-compatible API.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_SERVICE_PORT=8000
AI_INTERNAL_TOKEN=
# Local development task executor. Production can replace this adapter with RabbitMQ.
AI_TASK_EXECUTOR=local
AI_AGENT_MAX_ROUNDS=3
AI_TASK_DB_PATH=.data/ai_tasks.sqlite3
AI_NOTE_QUEUE=fs.ai.note.queue
AI_NOTE_PREFETCH=2
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Optional Core context endpoint for a future authenticated context provider.
CORE_INTERNAL_BASE_URL=
CORE_INTERNAL_TOKEN=
# Retrieval is opt-in. The embedding endpoint must implement OpenAI's
# /embeddings contract and its model revision is recorded in eval artifacts.
QDRANT_ENABLED=false
QDRANT_URL=http://localhost:6333
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Set only in the controlled integration evaluation target. This JSONL file
# contains evaluation prompts/responses and must not point to a production path.
AI_EVAL_TRACE_FILE=
