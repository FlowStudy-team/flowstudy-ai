DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_SERVICE_PORT=8000
AI_INTERNAL_TOKEN=
# Local development task executor. Production can replace this adapter with RabbitMQ.
AI_TASK_EXECUTOR=local
AI_TASK_DB_PATH=.data/ai_tasks.sqlite3
AI_NOTE_QUEUE=fs.ai.note.queue
AI_NOTE_PREFETCH=2
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Optional Core context endpoint for a future authenticated context provider.
CORE_INTERNAL_BASE_URL=
CORE_INTERNAL_TOKEN=
